{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "git-submodules"
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "prHourlyLimit": 1,
  "timezone": "Europe/Copenhagen",
  "schedule": [
    "at any time"
  ]
}
